{
  "name": "storybook-addon-vue-slots",
  "version": "0.9.29",
  "description": "Vue Slots support for Storybook",
  "type": "module",
  "keywords": [
    "storybook-addons",
    "storybook",
    "vue",
    "vue3",
    "slots"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JoJk0/storybook-addon-vue-slots"
  },
  "author": "Jacob Janisz",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:watch": "pnpm build --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "run-p build:watch 'storybook --quiet'",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "pnpm build && auto shipit",
    "storybook": "storybook dev -p 6066",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "preview-storybook": "vite preview --port 6088 --out-dir storybook-static"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@storybook/addon-docs": "^10.1.0",
    "@storybook/addon-links": "^10.0.0",
    "@storybook/builder-vite": "^10.0.0",
    "@storybook/vue3": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "auto": "^11.3.0",
    "boxen": "^8.0.1",
    "cheerio": "1.1.2",
    "dedent": "^1.5.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "next",
    "eslint-plugin-vue": "^10.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.2",
    "storybook": "next",
    "ts-dedent": "^2.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.0.58",
    "vue": "^3.5.25",
    "zx": "^8.7.1"
  },
  "peerDependencies": {
    "storybook": "^10.0.0",
    "vue": "^3.5.0"
  },
  "bundler": {
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Vue Slots",
    "supportedFrameworks": [
      "vue3"
    ],
    "icon": "https://api.iconify.design/logos/vue.svg"
  },
  "publishConfig": {
    "access": "public"
  },
  "auto": {
    "plugins": [
      "npm"
    ]
  }
}
